{
  "name": "majitkirana-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MajitKirana API — single-store kirana order & pickup backend",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
