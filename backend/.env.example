# Runtime
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173

# Database (local Docker Postgres runs on 5433)
DATABASE_URL="postgresql://majit:majit@localhost:5433/majitkirana?schema=public"

# Sessions (minimum 16 characters; use a random 32+ char value in production)
SESSION_SECRET="change-me-to-a-random-32-char-string"

# Owner account (used by the seed script)
# Replace with the real shop phone number later.
ADMIN_LOGIN="9000000000"
ADMIN_PASSWORD="change-me-before-seed"

# Tests (optional overrides; defaults point to majitkirana_test on localhost:5433)
# TEST_DATABASE_URL="postgresql://majit:majit@localhost:5433/majitkirana_test?schema=public"
# TEST_SESSION_SECRET="test-session-secret-32-characters"

# Web Push (optional). Generate once with:
#   npx web-push generate-vapid-keys --json
# Leave empty to disable push; the API and receipts still work.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:owner@majitkirana.example"

# OTP login (designed, not implemented yet — see docs/otp-design.md)
# OTP_PROVIDER=console
# OTP_HASH_SECRET="another-random-32-plus-char-string"
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# OTP_GLOBAL_DAILY_CAP=500
